{
  "name": "to-words",
  "version": "7.4.1",
  "description": "Number to words converter for 137 locales: amounts in words for invoices and cheques, currency, ordinals and BigInt (TypeScript, ESM/CJS/UMD).",
  "keywords": [
    "amount in words",
    "amount to words",
    "bigint",
    "cardinal",
    "check writing",
    "cheque amount in words",
    "convert-numbers",
    "converter",
    "currency",
    "currency amount to words",
    "currency to words",
    "en lettres",
    "i18n",
    "in worten",
    "international number to words",
    "international number to words currency",
    "internationalization",
    "invoice amount in words",
    "localization",
    "multilingual",
    "nombre en lettres",
    "num2words",
    "number",
    "number in words",
    "number to text",
    "number to words",
    "number to words converter",
    "number to words currency",
    "number-to-words",
    "numbers to words",
    "numbers-to-words",
    "numero a letras",
    "numero por extenso",
    "ordinal",
    "ordinal words",
    "por extenso",
    "rupees in words",
    "spell out numbers",
    "terbilang",
    "to words",
    "typescript",
    "word",
    "zahl in worten",
    "сумма прописью",
    "число прописью",
    "تفقيط"
  ],
  "homepage": "https://mastermunj.github.io/to-words/",
  "bugs": {
    "url": "https://github.com/mastermunj/to-words/issues"
  },
  "license": "MIT",
  "author": "Munjal Dhamecha",
  "repository": {
    "type": "git",
    "url": "https://github.com/mastermunj/to-words.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/mastermunj"
  },
  "bin": {
    "to-words": "./dist/cjs/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/cjs/ToWords.js",
  "module": "dist/esm/ToWords.js",
  "browser": "dist/umd/to-words.min.js",
  "types": "dist/types/ToWords.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/types/locales/*"
      ],
      "types": [
        "dist/types/types"
      ],
      "core": [
        "dist/types/ToWordsCore"
      ],
      "locale-contract": [
        "dist/types/locale-contract"
      ],
      "errors": [
        "dist/types/errors"
      ],
      "manifest": [
        "dist/types/locale-manifest"
      ]
    }
  },
  "unpkg": "dist/umd/to-words.min.js",
  "jsdelivr": "dist/umd/to-words.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/ToWords.d.ts",
      "import": "./dist/esm/ToWords.js",
      "require": "./dist/cjs/ToWords.js"
    },
    "./*": {
      "types": "./dist/types/locales/*.d.ts",
      "import": "./dist/esm/locales/*.js",
      "require": "./dist/cjs/locales/*.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "import": "./dist/esm/types.js",
      "require": "./dist/cjs/types.js"
    },
    "./core": {
      "types": "./dist/types/ToWordsCore.d.ts",
      "import": "./dist/esm/ToWordsCore.js",
      "require": "./dist/cjs/ToWordsCore.js"
    },
    "./locale-contract": {
      "types": "./dist/types/locale-contract.d.ts",
      "import": "./dist/esm/locale-contract.js",
      "require": "./dist/cjs/locale-contract.js"
    },
    "./errors": {
      "types": "./dist/types/errors.d.ts",
      "import": "./dist/esm/errors.js",
      "require": "./dist/cjs/errors.js"
    },
    "./manifest": {
      "types": "./dist/types/locale-manifest.d.ts",
      "import": "./dist/esm/locale-manifest.js",
      "require": "./dist/cjs/locale-manifest.js"
    }
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:umd && npm run build:pkgjson && npm run build:cli",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:cli": "chmod +x dist/cjs/cli.js",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:pkgjson": "echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:umd": "node --experimental-strip-types scripts/build-umd.ts",
    "build:watch": "npm run build -- --watch",
    "clean": "rimraf dist coverage",
    "commit": "git-cz",
    "docs:build": "npm run docs:check && vitepress build docs && npm run docs:verify",
    "docs:check": "npm run build:esm && node scripts/generate-locale-docs.mjs --check",
    "docs:dev": "vitepress dev docs",
    "docs:generate": "npm run build:esm && node scripts/generate-locale-docs.mjs && npm run build:esm",
    "docs:preview": "vitepress preview docs",
    "docs:verify": "node scripts/check-docs-build.mjs",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "lint": "oxlint --type-aware .",
    "lint:fix": "npm run lint -- --fix",
    "locale-registry:update": "node scripts/update-iana-language-subtags.mjs",
    "prepare": "husky",
    "size:check": "npm run build:umd -- --verbose",
    "test": "vitest",
    "test:locale-quality": "vitest --run --coverage.enabled=false __tests__/locale-codes.test.ts __tests__/locale-conformance.test.ts __tests__/locale-contract.test.ts __tests__/locale-invariants.test.ts __tests__/locale-manifest.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:watch": "npm run test -- --watch"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@mastermunj/oxc-config": "^0.0.7",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/source-map-support": "^0.5.10",
    "@vitest/coverage-v8": "^5.0.5",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.15",
    "source-map-support": "^0.5.21",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "commitizen": {
      "lodash": "4.17.23"
    },
    "tmp": "0.2.5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
